{
  "all": true,
  "include": [
    "*.js",
    "test/**/*.js"
  ],
  "exclude": [
    "node_modules/**",
    "proto/**",
    "coverage/**",
    "test/**",
    "scripts/**",
    ".github/**"
  ],
  "reporter": [
    "cobertura",
    "text",
    "html",
    "lcov"
  ],
  "report-dir": "./coverage",
  "temp-dir": "./.nyc_output",
  "check-coverage": true,
  "branches": 60,
  "lines": 70,
  "functions": 75,
  "statements": 70,
  "per-file": false,
  "skip-full": false
}